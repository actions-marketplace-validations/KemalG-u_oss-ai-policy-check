{
  "version": "4.0",
  "ai_term_exact": "\\bAIs?\\b(?!\\s*(?:API|librar|script|player|opponent))|\\bLLMs?\\b|\\bAI-\\w+",
  "ai_term": "\\b(?:(?<!user )(?<!user-)(?<!ssh )(?<!ssh-)(?<!build )(?<!http )(?<!mail )agents?|agentic|artificial intelligence|language models?|ChatGPT|Copilot|Claude|Gemini|generative|machine[- ]generated|tool[- ]generated|code assistants?|coding assistants?|code assistance|chat ?bots?)\\b",
  "narrowing_qualifiers": [
    "@qualifier",
    "@weak_scope",
    "@conditional",
    "@degree",
    "\\b(?:raw|unverified|unchecked|untested|unedited|indiscriminate\\w*|wholesale|bulk|mass(?:[- ]produced)?)\\b",
    "\\bwall of\\b|\\bto disguise\\b|\\b(?:submitted|generated|merged|pushed|written|opened|produced)\\s+(?:\\w+\\s+){0,3}without\\s+(?:\\w+\\s+){0,2}(?:review|testing|checking|scrutiny)\\b",
    "\\b(?:substantial|wholly|mostly|mainly|exclusively|simply|merely)\\b",
    "\\bnot\\s+explicitly\\s+(?:allowed|permitted|listed|covered)\\b",
    "\\b(?:as an? (?:substitute|replacement) for|(?:instead|in place) of (?:\\w+\\s+){0,2}(?:understand\\w*|review\\w*|read\\w*|check\\w*|test\\w*|think\\w*)|without\\s+(?:\\w+\\s+){0,2}(?:reviewing|understanding|reading|checking|verifying|testing)|blindly)\\b"
  ],
  "review_cue": {
    "paths": "(?:^|/)(?:README[^/]*|AGENTS\\.md|CLAUDE\\.md|GEMINI\\.md|Agents\\.md|\\.cursorrules|copilot-instructions[^/]*)$",
    "cue": "\\bcontribut\\w*|\\bpull[- ]requests?\\b|\\bPRs?\\b|\\bpatch(?:es)?\\b|\\bsubmi\\w+|\\bcommits?\\b|\\bissues?\\b|\\bAI polic(?:y|ies)\\b|\\bdisclos\\w*",
    "exclude": [
      "\\b(?:no|not have|(?:do|does)n't have|without|lacks?)\\s+(?:an?\\s+|any\\s+)?(?:\\w+\\s+){0,2}(?:AI|LLM)\\s+(?:polic(?:y|ies)|rules|guidelines)\\b"
    ],
    "soft_verbs": "\\b(?:should|expect(?:s|ed)?|please|encourag\\w+|feel free|free to|appreciat\\w+|prefer\\w*|recommend(?:s|ed)?|ask(?:s|ed)?|responsib\\w+|mindful|careful\\w*|fine|ok|okay|happy|glad|can use|may use|up to you|your call|at your own)\\b"
  },
  "agent_files": {
    "paths": "(?-i:(?:^|/)(?:AGENTS|CLAUDE|GEMINI)\\.md$|^(?:\\.github/)?Agents\\.md$)|copilot-instructions|\\.cursorrules|(?:^|/)\\.cursor/rules/|(?:^|/)\\.github/instructions/",
    "scope": "\\bcontribut\\w+|\\bpull[- ]requests?\\b|\\bPRs?\\b|\\bpatch(?:es)?\\b|\\bsubmi\\w+|\\bissues?\\b|\\bcommits?\\b|\\bAI polic(?:y|ies)\\b|\\bdisclos\\w*"
  },
  "named": {
    "ai_strict": "\\bAIs?\\b(?!\\s*(?:API|librar|script|player|opponent))|\\bLLMs?\\b|\\bAI-\\w+|(?i:\\b(?:artificial intelligence|large language models?|language models?|ChatGPT|Copilot|Claude|Gemini|generative|machine[- ]generated|tool[- ]generated|chat ?bots?|code assistants?|coding assistants?|assistance tools?)\\b)",
    "broad": "(?i:\\bcontribut(?:ion|e|ing)s?\\b|pull[- ]requests?|\\bPRs?\\b|\\bpatch(?:es)?\\b|\\bcode\\b|\\bsubmi\\w+|\\bmaterial\\b|\\bcontent\\b|\\bdevelopment\\b|(?:use|using|usage)\\s+of\\s+(?:any\\s+(?:and\\s+all\\s+)?|all\\s+)?(?:AI|LLMs?|generative)\\b[^.!?]{0,40}\\bproject\\b)",
    "narrow": "(?i:(?:comments?|repl(?:y|ies)|responses?|messages?|posts?)\\s+(?:on|in|to|for)\\s+(?:\\w+\\s+){0,3}(?:issues?|PRs?|pull[- ]requests?|threads?|discussions?)|(?:(?:pull[- ]requests?|PR|issue|bug|commit|review|discussion|code)\\s+)?(?:descriptions?|comments?|repl(?:y|ies)|responses?|messages?|posts?|communications?|bodies|text|answers?|reports?|discussions?)|\\b(?:in\\s+)?explaining\\s+(?:your|the)\\s+(?:contribution|change)s?|\\b(?:art|artwork|images?|media|videos?|audio|assets|documentation|docs?|translations?|translating|proofreading)\\b)",
    "voice_target": "(?i:prose|descriptions?|comments?|repl(?:y|ies)|responses?|messages?|\\bposts?\\b|communicat\\w+|discussions?|issue (?:text|reports?|bodies|descriptions?)|bug reports?|\\bsecurity reports?|\\breports?\\b|answers?|review (?:comments|replies)|PR (?:bodies|text)|\\bspeak\\b|\\bthink for you\\b)",
    "media": "(?i:\\b(?:art(?!\\.?\\s*\\d)|artwork|images?|media|videos?|audio|graphics|icons|illustrations?|music|sounds?|assets|logos?|textures?|3d models?)\\b)",
    "prohibit": "(?i:\\b(?:forbid\\w*|prohibit\\w*|ban(?:s|ned)?|disallow\\w*|unacceptable|refus\\w+|reject\\w*|discourag\\w+|do(?:es)?(?:n't| not)|will not|won't|must not|mustn't|should not|shouldn't|never|not (?:be )?(?:allowed|accepted|permitted|welcome\\w*|tolerated)|no)\\b)",
    "prohibit_negation": "(?i:(?:not|n't|never|no)\\s+(?:\\w+\\s+){0,2}(?:prohibit\\w*|ban(?:s|ned|ning)?\\b|forbid\\w*|disallow\\w*|reject\\w*|object\\w*)|\\bno\\s+(?:blanket\\s+)?(?:ban|prohibition)|not\\s+(?:due to\\s+)?an?\\s+anti-?\\s?AI|not\\s+anti-?\\s?AI)",
    "disclose_negation": "(?i:(?:do|does|did|will|would|could)(?:n't| not)\\s+(?:\\w+\\s+){0,2}(?:require|need|have to|ask|expect|demand)|(?:not|n't|never|no)\\s+(?:be\\s+)?(?:required|necessary|needed|mandatory|expected|obligatory)|no\\s+(?:\\w+\\s+){0,2}need|need not|not (?:be )?disclosed|must not\\b[^.!?]{0,30}disclos)",
    "conditional": "(?i:\\b(?:unless|as long as|provided(?: that)?|only (?:when|if)|so long as)\\b|\\b(?:except(?:\\s+for)?|other than|apart from|aside from)\\b(?!\\s+(?:\\w+\\s+){0,3}(?:translat\\w+|proofread\\w*|grammar|spell\\w*))|,\\s*or\\s+(?:I|we|you)\\b|\\bor\\s+(?:I|we)\\s+(?:have\\s+)?disclos|\\bdid or did not\\b)",
    "weak_scope": "(?i:good[- ]first[- ]issues?|first[- ](?:time )?(?:pull request|PR|contribution)|vouch\\w*|undisclos\\w*|without (?:\\w+ ){0,3}disclos\\w*|obscur\\w*|conceal\\w*|\\bhidden\\b|unreviewed|unsupervised|autonomous\\w*|purely agentic|fully agentic|no meaningful human|without (?:\\w+ ){0,3}(?:oversight|understanding|human\\b|permission|approval|verif\\w*)|low[- ]quality|\\bslop\\b|\\bspam\\w*|hallucinat\\w*|can(?:'|no)t (?:explain|understand)|not (?:been )?(?:reviewed|tested|verified)|\\bbots?\\b|\\bagents?\\b|DeepSeek|Grammarly|\\bonly\\b[^.!?]{0,40}(?:autocomplet\\w*|translat\\w*|proofread\\w*|spell\\w*)|\\bdisclos\\w*|automated (?:AI )?(?:code )?review|one[- ]shot|fire[- ]and[- ]forget|low[- ]effort|drive-by|shotgun|without\\s+(?:\\w+\\s+){0,2}(?:review|check|test|verify|understand)ing)",
    "permission_then_but": "(?i:\\b(?:fine|welcome\\w*|encourag\\w+|okay|allowed|permitted|appreciate\\w*)\\b[^.!?]{0,120}\\b(?:but|however|though|although)\\b)",
    "qualifier": "(?i:\\b(?:that|which|who|whose)\\s+(?!(?:are|is|have|has|were|was)\\b)|\\byou\\s+(?:haven't|have not|can't|cannot|don't|do not|didn't|did not)\\b|\\b(?:unreviewed|unvetted|blind(?:ly)?)\\b|\\b(?:fully|entirely|solely|primarily|mostly|purely|completely|largely|significantly)\\b)",
    "sanction": "(?i:(?:temporary|permanent|public|lifetime)\\s+ban\\b|\\b(?:will|may|can|could|shall)\\s+(?:\\w+\\s+){0,3}(?:ban(?:ned)?|block(?:ed)?)\\b|\\bbans?\\s+(?:from|you|the (?:user|account))|https?://|\\]\\[|\\]\\()",
    "discretion": "(?i:\\b(?:may|might|could|reserve the right|right to|at (?:our|the maintainers') discretion|typically|usually|generally|often|sometimes|likely|tend to)\\b)",
    "disclosing": "(?i:\\bdisclos\\w*|\\bcredit\\w*|\\bmention\\w*|\\blabel\\w*|\\btrailers?\\b|\\bsay so\\b|\\bstate that\\b|\\bfooters?\\b|\\backnowledg\\w*|\\bdeclar\\w*|\\bname the\\b)",
    "author_verb": "(?i:\\b(?:writ\\w+|wrote|generat\\w+|draft\\w*|compos\\w+|speak\\w*|communicat\\w+|author\\w*|produc\\w+|creat\\w+|answer\\w*|respon\\w+|repl\\w+|post\\w*)\\b)",
    "negative": "(?i:\\b(?:forbid\\w*|prohibit\\w*|ban(?:s|ned)?|disallow\\w*|unacceptable|refus\\w+|reject\\w*|discourag\\w+|avoid|refrain|no unsolicited|(?:do|does|must|should|may|can|will|shall)(?:n't| not)?\\s*(?:not|never|n't)\\s+(?:\\w+\\s+){0,2}(?:use|let|allow|have|ask|rely|relay|post|submit|paste|copy|generate|write|draft|speak|answer|reply|respond|communicate|send|request)|(?:don't|never|do not)\\s+(?:\\w+\\s+){0,2}(?:use|let|allow|have|ask|rely|relay|post|submit|paste|copy|generate|write|draft|speak|answer|reply|respond|communicate)|not (?:be )?(?:allowed|accepted|permitted|welcome\\w*|tolerated|ok(?:ay)?|acceptable))\\b)",
    "disclosing_strict": "(?i:\\bdisclos\\w*|\\backnowledg\\w*|\\bdeclar\\w*)",
    "pointer": "(?i:\\b(?:see|read|review|refer(?:\\s+\\w+)?\\s+to|follow|check|consult|comply with)\\b[^.!?]{0,60}\\b(?:polic(?:y|ies)|guidelines?)\\b|\\bpolic(?:y|ies)\\b\\s*:\\s*\\S*$|\\bour AI polic)",
    "list_intro": ":[*_\\s]*$",
    "voice_use": "(?i:\\b(?:to|for)\\s+(?:\\w+\\s+){0,2}(?:speak|talk|communicat\\w+|interact\\w*|think|chat|respond|reply|answer)\\b|\\bin\\s+(?:\\w+\\s+){0,2}(?:discussions?|conversations?)\\b)",
    "scoped_issue": "(?i:\\bissues?\\b[^.!?]{0,60}\\b(?:that|which)\\s+(?:have|has|had|are|is)\\s+(?:not|n't)\\b|\\b(?:not|n't)\\s+(?:yet\\s+)?been\\s+(?:marked|labell?ed|triaged|accepted|approved|assigned)\\b|\\b(?:not|n't)\\s+(?:yet\\s+)?(?:marked|labell?ed|triaged)\\b|\\bfor\\s+(?:accepted|approved|triaged|assigned|unassigned)\\s+issues|\\botherwise\\b)",
    "automation_subject": "(?i:\\b(?:CI|workflows?|pipelines?|validators?|linters?|checks?|bots?|actions?)\\s+(?:\\w+\\s+)?(?:will\\s+)?(?:reject|refuse|decline|fail)s?\\b)",
    "plugin_manifest": "(?i:\\b(?:plugins?|marketplace|extension|manifest)s?(?:\\.json)?\\b[^.!?]{0,80}\\bversions?\\b|\\bversions?\\b[^.!?]{0,40}\\b(?:plugins?|manifests?)\\b)",
    "historical": "(?i:\\bversion\\s+\\d|\\b(?:previously|formerly|used to|earlier version|superseded)\\b)",
    "degree": "(?i:\\b(?:unreviewed|unvetted|blind(?:ly)?)\\b)",
    "voice_or_noai": "(?i:prose|escriptions?|comments?|repl(?:y|ies)|responses?|messages?|\\bposts?\\b|communicat\\w+|discussions?|issue (?:text|reports?|bodies|descriptions?)|bug reports?|\\bsecurity reports?|\\breports?\\b|answers?|review (?:comments|replies)|PR (?:bodies|text)|\\bspeak\\b|\\bthink for you\\b|\\b(?:no|without)\\s+(?:AI|LLMs?)\\b)",
    "trailer_ai": "(?i:\\b(?:AI|LLMs?|agents?|assistants?|models?|vendors?|bots?|Copilot|Claude|Assisted-by|Generated[- ](?:by|with)|attribution)\\b)",
    "disclosure_word": "(?i:\\bdisclos\\w*|\\bdisclaim\\w*|\\backnowledg\\w*|\\bdeclar\\w*|Assisted-by|\\bAI[- ]assisted\\b|\\battribut\\w*|\\bcredit\\w*|\\btrailers?\\b)",
    "ai_authored": "(?i:\\b(?:AI|LLM|machine|agent|bot)[- ](?:generated|written|authored|produced|drafted|made|created)\\b|\\b(?:generated|written|authored|produced|drafted|composed|created)\\s+(?:entirely\\s+|fully\\s+|mostly\\s+)?(?:by|with|using)\\s+(?:an?\\s+)?(?:AI|LLMs?|agents?|bots?|language models?|Claude|ChatGPT|Copilot)\\b|\\bAI[- ]?(?:written|generated|authored)\\b)"
  },
  "rules": [
    {
      "id": "general-ban",
      "class": "banned",
      "require": [
        "ai_strict",
        "broad"
      ],
      "narrow": true,
      "negate": "prohibit_negation",
      "forbid": [
        "permission_then_but",
        "sanction",
        "discretion",
        "list_intro",
        "pointer",
        "voice_use",
        "scoped_issue",
        "historical",
        "automation_subject",
        "plugin_manifest"
      ],
      "regex": "\\b(?:forbid\\w*|prohibit\\w*|ban(?:s|ned)?|disallow\\w*|unacceptable)\\b|\\bnot\\s+(?:be\\s+)?(?:accept\\w*|allow\\w*|permit\\w*|tolerat\\w*|welcome\\w*|look(?:ed)? at|merged|considered)|(?:do|does|will|would|can|may|must|should|shall)(?:n't| not)\\s+(?:accept|allow|permit|tolerate|merge|consider|be used|be submitted|submit|contribute|take\\s+(?:\\w+\\s+){0,2}(?:AI|LLM|generated|contributions?|PRs?|patches))|\\b(?:don't|do not|never|please don't)\\s+(?:\\w+\\s+){0,2}(?:submit|contribute|send|post|open)\\b|\\b(?:don't|do not|never|must not|please do not)\\s+use\\s+(?:\\w+\\s+){0,2}(?:AI|LLMs?|generative|ChatGPT|Copilot)\\b|\\brefrain from\\b|\\b(?:reject|decline|refuse)(?:s|d)?\\b|\\bclosed (?:on sight|immediately|without review)|\\bshould not be used\\b|\\bno\\s+(?:AI|LLM)[- ]?(?:generated|written|assisted)\\b|\\bno\\s+(?:AI|LLMs?)\\b(?:\\s*/\\s*no\\s+(?:AI|LLMs?)\\b)?\\s*(?:for|in|policy|contributions?|allowed)|\\b(?:must|shall|may|can|will)(?:n't| not)\\s+(?:include|contain)\\b|\\bask(?:ed)?\\s+(?:you\\s+)?not\\s+to\\s+(?:open|submit|send|use|contribute)\\b|\\bno\\s+(?:\\w+\\s+){0,2}of\\s+(?:AI|LLM)[- ]generated\\b",
      "exclude": [
        "\\bAI[- ](?:generated|written|authored)\\s+(?:prose|text|wording|writing|issues?|comments?|bug reports?|replies|descriptions?)\\b(?!\\s*(?:,|/|or\\b|and\\b)?\\s*(?:\\w+\\s+){0,2}(?:code|PRs?|pull|patch\\w*|contribut\\w*|changes?|commits?))"
      ],
      "forbid_document": [
        "(?:limited|small|minimal|sporadic)\\s+(?:cases|amounts?)\\b(?:e\\.g\\.|[^.!?]){0,120}\\bautocomplet\\w+|\\bonly\\b(?:e\\.g\\.|[^.!?]){0,40}\\bautocomplet\\w+|\\bautocomplet\\w+\\s+only\\b|\\bassistively\\b"
      ],
      "demote_on": [
        "narrowing_qualifiers"
      ],
      "demote_document": [
        "\\b(?:AI|LLMs?)\\b[^.!?]{0,60}\\b(?:is|are)\\s+(?:usually|generally|mostly|typically|often|largely)\\s+(?:fine|ok(?:ay)?|acceptable|allowed|welcome\\w*)\\b"
      ],
      "demote_to": "restricted"
    },
    {
      "id": "disclosure",
      "class": "disclosure-required",
      "negate": "disclose_negation",
      "require": [
        "ai_sentence"
      ],
      "regex": "(?:must|shall|required|require|need to|have to|should|expected to|asked to|ask you to|please|always|encourage\\w*|kindly|prefer\\w*|want you to|if you)[^.!?]{0,100}(?:disclos|disclaimer|declar|attribut|acknowledg|reveal|credit|indicat|mention|identify|label\\b|tag\\b|state\\b|inform)|(?:disclos|declar|reveal|acknowledg)\\w*[^.!?]{0,100}(?:must|required|all AI|AI (?:use|usage|assist|tool|generat)|use of AI|(?:LLM|tool)s? (?:use|usage|assist))|^\\W*(?:disclos\\w+|declare|reveal|acknowledge)\\s+[^.!?]{0,60}\\b(?:AI|LLM|assist\\w*|tool|agent)|Assisted-by:|Co-authored-by:[^.!?]{0,50}(?:AI|LLM)|undisclosed[^.!?]{0,80}(?:closed|reject)|\\bai-assisted\\b[^.!?]{0,40}\\blabel|\\blabel\\b[^.!?]{0,60}\\bai-assisted\\b|\\bdisclos(?:e|ure|ed)\\b|\\bdisclaimer\\b|\\bAI-assisted\\b[^.!?]{0,30}\\btrailer|\\btrailer\\b[^.!?]{0,40}\\bAI-assisted",
      "exclude": [
        "attribution is not welcome|No .?Co-Authored-By",
        "(?:do not|don't|never|must not)\\s+(?:\\w+\\s+){0,3}(?:add|include|use|put|append)\\b[^.!?]{0,60}(?:Co-Authored-By|Assisted-by|attribution)"
      ],
      "agent_file_require": [
        "disclosure_word"
      ]
    },
    {
      "id": "template-ai-prompt",
      "class": "disclosure-required",
      "paths": "(?:^|/)pull[-_]request[-_]template|(?:^|/)\\.github/.*(?:pull|pr)[-_]?.*template",
      "require": [
        "ai_sentence"
      ],
      "regex": "\\b(?:AI|LLM|Copilot|generative|code assistan)\\w*|\\b(?:AI|coding|autonomous|LLM)[- ]agents?\\b|\\bagents?\\b[^.!?]{0,40}\\b(?:us(?:e|ed|ing)|wrote|written|generated|authored|assisted|involved)\\b|\\b(?:us(?:e|ed|ing)|wrote|written|generated|authored|assisted|involved)\\b[^.!?]{0,40}\\bagents?\\b",
      "forbid": [
        "pointer"
      ],
      "exclude": [
        "\\b(?:request\\w*|ask\\w*|invok\\w*|trigger\\w*|summon\\w*)\\b[^.!?]{0,50}\\b(?:AI|automated|bot|Copilot|LLM)\\b[^.!?]{0,30}\\breview"
      ],
      "weak": true
    },
    {
      "id": "attribution-ban",
      "class": "restricted",
      "regex": "\\b(?:never|do not|don't|must not|should not|shouldn't)\\s+(?:\\w+\\s+){0,5}?(?:add|emit|include|append|use|put|insert|leave|write)\\b[^.!?]{0,70}(?:Co-Authored-By|Generated (?:with|by)|attribution|footers?|trailers?|adverts?|signatures?)|(?:Co-Authored-By|Generated (?:with|by)|attribution|footers?|trailers?)[^.!?]{0,60}(?:not (?:welcome|allowed|accepted|permitted)|(?:are |is )?(?:revoked|forbidden|prohibited|banned))|\\bno\\s+(?:\\w+\\s+)?(?:Co-Authored-By|attribution)\\b|\\bno\\s+(?:AI|LLM|bot)s?\\s+in\\s+`?Co-authored-by|\\b(?:defaults?|instructions?)\\b[^.!?]{0,60}\\brevoked\\b",
      "forbid": [
        "disclosing_strict"
      ],
      "require": [
        "trailer_ai"
      ],
      "agent_file": "exempt"
    },
    {
      "id": "own-voice",
      "class": "restricted",
      "regex": "\\bown\\s+human\\s+voice\\b|\\bnever\\s+let\\s+an?\\s+(?:AI|LLM)\\w*\\s+(?:speak|think|write)|\\bdescriptions? written by an agent|\\bmust\\s+not\\s+(?:contain|include)\\s+(?:\\w+\\s+){0,2}(?:AI|LLM)\\b",
      "exclude": [
        "\\bnot\\s+(?:required|needed)\\b"
      ]
    },
    {
      "id": "human-written",
      "class": "restricted",
      "require": [
        "voice_or_noai"
      ],
      "forbid": [
        "disclosing"
      ],
      "regex": "\\b(?:own\\s+(?:human\\s+)?(?:words|voice)|(?:written|authored|composed|produced|typed)\\s+(?:by|in)\\s+(?:a\\s+|the\\s+)?(?:human|person|hand|yourself|contributor|author|submitter)|human[- ](?:written|authored)|write\\s+(?:it|them|these|the\\s+\\w+)\\s+yourself|write\\s+[^.!?]{0,60}\\bby hand)\\b",
      "exclude": [
        "\\bnot\\s+(?:required|needed)\\b",
        "\\bsame\\b[^.!?]{0,30}\\bhuman[- ]written",
        "\\b(?:though|but|although|however)\\b[^.!?]{0,40}\\b(?:fine|ok(?:ay)?|allowed|acceptable|welcome\\w*)\\b",
        "\\b(?:with|using)\\s+the\\s+help\\s+of\\b[^.!?]{0,30}\\b(?:AI|LLM)"
      ],
      "weak": true
    },
    {
      "id": "ai-voice-ban",
      "class": "restricted",
      "require": [
        "ai_strict",
        "voice_target",
        "author_verb",
        "negative"
      ],
      "regex": "[^.!?]+",
      "exclude": [
        "\\b(?:if|when)\\b[^.!?]{0,80}\\b(?:disclos|review)",
        "\\bnot (?:required|needed)\\b",
        "\\buntil\\b",
        "\\b(?:prefer\\w*|advice|advise|ideally|recommend\\w*|suggest\\w*)\\b"
      ],
      "forbid": [
        "disclosing",
        "sanction",
        "discretion",
        "degree"
      ],
      "ctx_waives": [
        "negative"
      ],
      "weak": true,
      "agent_file_require": [
        "ai_authored"
      ],
      "window": 300
    },
    {
      "id": "media-ban",
      "class": "restricted",
      "require": [
        "ai_strict",
        "media",
        "prohibit"
      ],
      "regex": "\\b(?:AI|LLM)[- ]?(?:generated|made|created|produced)?\\s*[^.!?]{0,20}(?:art(?!\\.?\\s*\\d)|artwork|images?|media|videos?|audio|graphics|icons|illustrations?|music|sounds?|assets|logos?)\\b|\\b(?:art(?!\\.?\\s*\\d)|images?|media|videos?|audio|graphics|assets)\\b[^.!?]{0,40}\\b(?:AI|LLM)[- ]?generated"
    },
    {
